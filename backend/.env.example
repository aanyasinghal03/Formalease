# Copy this file to .env and fill in real values.
# If LLM_API_KEY is left blank, the app automatically uses the
# keyword-based fallback classifier (see services/nlp_service.py).

# API key for your LLM provider (Anthropic, OpenAI, etc.)
LLM_API_KEY=

# Model name to use, e.g. claude-sonnet-4-6 or gpt-4o-mini
LLM_MODEL=claude-sonnet-4-6

# Optional: override the LLM API base URL if not using Anthropic's default
LLM_API_BASE_URL=https://api.anthropic.com/v1/messages

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# SQLite database path
DATABASE_URL=sqlite:///./data/formalease.db
